{
  "name": "dwell-sim-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "dwell-sim-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "METHODOLOGY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json",
    "demo:export": "npm run build && node dist-scripts/export-demo-layout.js",
    "demo:export:board": "npm run build && node dist-scripts/export-board-layout.js",
    "demo:run": "npm run build && node dist-scripts/run-demo-presets.js",
    "board:run": "npm run build && node dist-scripts/run-board-presets.js",
    "methodology:tables": "npm run build && node dist-scripts/generate-methodology-tables.js",
    "demo:export:seance": "npm run build && node dist-scripts/export-seance-layout.js",
    "seance:run": "npm run build && node dist-scripts/run-seance-presets.js",
    "bundle:power": "npm run build && node dist-scripts/bundle-power.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@planchette/skeleton": "*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.1",
    "fast-check": "4.10.3",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
