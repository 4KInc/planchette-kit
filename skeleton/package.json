{
  "name": "@planchette/skeleton",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-license.mjs",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "fast-check": "4.10.3",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35"
  }
}
