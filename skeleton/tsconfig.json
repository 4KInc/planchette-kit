{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@planchette/skeleton": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "demo",
    "examples",
    "scripts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
